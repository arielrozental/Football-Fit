<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NAPOLI | Official Store</title>
    <style>
        /* עיצוב כללי בסגנון המותג */
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #000000;
            color: #ffffff;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* תפריט עליון */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            background-color: #000;
            border-bottom: 1px solid #222;
        }

        nav .logo { font-size: 24px; font-weight: bold; letter-spacing: 3px; }
        nav .links { display: flex; gap: 20px; font-size: 12px; text-transform: uppercase; }
        nav .links a { color: white; text-decoration: none; opacity: 0.7; transition: 0.3s; }
        nav .links a:hover { opacity: 1; }

        /* סקשן הירו (התמונה הראשית) */
        .hero {
            height: 80vh;
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('hero-bg.jpg'); /* שים כאן תמונה כללית של המותג */
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .hero h1 { font-size: 80px; margin: 0; letter-spacing: 10px; }
        .hero .shop-now {
            margin-top: 20px;
            padding: 12px 30px;
            border: 1px solid white;
            background: transparent;
            color: white;
            cursor: pointer;
            text-transform: uppercase;
            transition: 0.3s;
        }
        .hero .shop-now:hover { background: white; color: black; }

        /* כותרת SHOP */
        .shop-title { text-align: center; padding: 50px 0; font-size: 30px; letter-spacing: 5px; }

        /* גריד מוצרים */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            padding: 20px;
        }

        .product-card {
            background-color: #000;
            cursor: pointer;
            transition: 0.3s;
        }

        .product-card img {
            width: 100%;
            display: block;
            background-color: #111; /* צבע רקע לתמונה אם היא נטענת */
        }

        .product-info {
            padding: 20px 0;
            border-top: 1px solid #222;
        }

        .product-info h3 { margin: 0; font-size: 16px; text-transform: uppercase; letter-spacing: 1px; }
        .product-info p { margin: 5px 0; color: #888; font-size: 14px; }
        .price { font-weight: bold; margin-top: 10px; }

        /* דף מוצר (מוסתר) */
        #detail-page {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 1000;
            padding: 50px 20px;
            box-sizing: border-box;
            overflow-y: auto;
        }

        .detail-content {
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .detail-content img { width: 100%; border-radius: 5px; }
        .detail-content h2 { font-size: 32px; letter-spacing: 3px; margin: 30px 0; }
        .detail-description { color: #ccc; line-height: 1.8; margin-bottom: 40px; }

        .whatsapp-btn {
            display: block;
            background: white;
            color: black;
            padding: 20px;
            text-decoration: none;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: 0.3s;
        }

        .whatsapp-btn:hover { opacity: 0.8; }
        .close-btn { color: white; background: none; border: none; font-size: 30px; cursor: pointer; position: absolute; top: 20px; right: 20px; }

        footer {
            padding: 50px;
            text-align: center;
            border-top: 1px solid #222;
            margin-top: 100px;
            color: #444;
            font-size: 12px;
        }
    </style>
</head>
<body>

<nav>
    <div class="logo">NAPOLI</div>
    <div class="links">
        <a href="#" onclick="showHome()">HOME</a>
        <a href="#">SHOP</a>
        <a href="#">ABOUT</a>
        <a href="#">CONTACT</a>
    </div>
</nav>

<div id="home-view">
    <div class="hero">
        <h1>NAPOLI</h1>
        <button class="shop-now">SHOP NOW</button>
    </div>

    <div class="shop-title">SHOP</div>

    <div class="container">
        <!-- מוצר 1 -->
        <div class="product-card" onclick="openProduct('shirt')">
            <img src="shirt.jpg" alt="NAPOLI TEE">
            <div class="product-info">
                <h3>NAPOLI TEE</h3>
                <p>BLACK</p>
                <div class="price">₪150.00</div>
            </div>
        </div>

        <!-- מוצר 2 -->
        <div class="product-card" onclick="openProduct('shorts')">
            <img src="shorts.jpg" alt="NAPOLI SHORTS">
            <div class="product-info">
                <h3>NAPOLI SHORTS</h3>
                <p>BLACK</p>
                <div class="price">₪150.00</div>
            </div>
        </div>
    </div>
</div>

<!-- דף מוצר -->
<div id="detail-page">
    <button class="close-btn" onclick="showHome()">×</button>
    <div class="detail-content">
        <img id="detail-img" src="" alt="">
        <h2 id="detail-title"></h2>
        <p class="detail-description">
            100% כותנה איכותית. <br>
            החולצה נשמרת מצוין בכביסה, נוחה לכל כיס ומתאימה לכל אדם. <br><br>
            <strong>תודה שקניתם נאפולי.</strong>
        </p>
        <a id="wa-link" href="#" class="whatsapp-btn">להזמנה ב-WhatsApp</a>
    </div>
</div>

<footer>
    © 2024 NAPOLI. ALL RIGHTS RESERVED.
</footer>

<script>
    function openProduct(type) {
        document.getElementById('home-view').style.display = 'none';
        document.getElementById('detail-page').style.display = 'block';
        
        const title = document.getElementById('detail-title');
        const img = document.getElementById('detail-img');
        const link = document.getElementById('wa-link');
        const phone = "972508353336";

        if(type === 'shirt') {
            title.innerText = "NAPOLI TEE";
            img.src = "shirt.jpg";
            link.href = `https://wa.me/${phone}?text=היי, אני רוצה להזמין את חולצת נאפולי`;
        } else {
            title.innerText = "NAPOLI SHORTS";
            img.src = "shorts.jpg";
            link.href = `https://wa.me/${phone}?text=היי, אני רוצה להזמין את מכנס נאפולי`;
        }
        window.scrollTo(0,0);
    }

    function showHome() {
        document.getElementById('home-view').style.display = 'block';
        document.getElementById('detail-page').style.display = 'none';
    }
</script>

</body>
</html>
